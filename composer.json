{
  "name": "meritum/http",
  "description": "Module-first PSR-15 HTTP kernel for the Meritum ecosystem",
  "type": "library",
  "authors": [
    {
      "name": "Mike Georgeff",
      "email": "mike@georgeff.co",
      "role": "Author"
    }
  ],
  "license": "MIT",
  "require": {
    "php": "^8.4",
    "georgeff/kernel": "^2.0",
    "laminas/laminas-diactoros": "^3.0",
    "nikic/fast-route": "^1.3",
    "psr/http-factory": "^1.1",
    "psr/http-message": "^1.1",
    "psr/http-server-middleware": "^1.0",
    "relay/relay": "^2.1"
  },
  "require-dev": {
    "bnf/phpstan-psr-container": "^1.0",
    "phpstan/phpstan": "^2.0",
    "phpunit/phpunit": "^11.0",
    "squizlabs/php_codesniffer": "^3.11"
  },
  "autoload": {
    "psr-4": {
      "Meritum\\Http\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Meritum\\Http\\Test\\": "tests/"
    }
  },
  "config": {
    "sort-packages": true
  },
  "scripts": {
    "test": [
      "vendor/bin/phpunit"
    ],
    "analyze": [
      "vendor/bin/phpstan"
    ],
    "phpcs": [
      "vendor/bin/phpcs"
    ]
  }
}
